# Serviço FastAPI
PORT=8000
HOST=0.0.0.0
AI_ENGINE_API_KEY=vice_ai_secret_engine_key_2026

# Supabase (PostgreSQL / Storage)
SUPABASE_URL=https://kerkwjhuneardiexhnek.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Google Gemini (Análise Semântica de Conteúdo & Viral Score)
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-gemini-api-key-aqui

# Whisper (Transcrição Audiovisual)
