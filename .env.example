# ==============================================================================
# VICE CLIPPER — Variáveis de Ambiente Oficiais (Produção & Local)
# ==============================================================================

# Supabase (PostgreSQL 14+)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mercado Pago — API Oficial de Assinaturas (Preapproval) e Checkout
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL Base da Aplicação (Em produção na Vercel: https://seu-dominio.vercel.app)
NEXT_PUBLIC_APP_URL=https://vice-clipper.vercel.app

# (Opcional, mas Altamente Recomendado para Vercel) Cookies de Sessão do YouTube
# Bypassa o bloqueio de IP de Datacenter do YouTube ("Bot Check" / HTTP 429) em produção
# Obtenha exportando os cookies do YouTube logado via extensão (ex: Cookie-Editor ou Get cookies.txt)
YOUTUBE_COOKIE=

# (Opcional) Motor de IA Python (FastAPI / Whisper) se hospedado externamente (ex: Railway, Render)
# Se não preenchido, o sistema utiliza o algoritmo resiliente nativo com pontuação viral Vice
AI_ENGINE_URL=http://127.0.0.1:8000
AI_ENGINE_API_KEY=vice_ai_secret_engine_key_2026
